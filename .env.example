# ---- LLM 提供商（deepseek | openai | custom）----
LLM_PROVIDER=deepseek

# DeepSeek（默认）
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-your-deepseek-key
OPENAI_MODEL=deepseek-chat

# 切换到 OpenAI 只需改下面几行：
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4o-mini

# 其他兼容接口（Ollama / vLLM / 国产模型等）：
# LLM_PROVIDER=custom
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5:7b

# ---- 可选 ----
JWT_SECRET=dev-secret
LOG_LEVEL=INFO
LOG_FORMAT=console

# ---- 示例域开关（默认关；置 1 看 example_todo）----
ENABLE_EXAMPLE_DOMAIN=0

# ---- skills（Markdown 能力包；目录不存在 = 无 skill）----
SKILLS_DIR=skills

# ---- memory（默认 in-memory；留空 = 关闭外部依赖）----
ENABLE_LLM_PREF_EXTRACTION=0
AGENT_PG_DSN=
AGENT_EMBED_BASE_URL=
AGENT_EMBED_API_KEY=
AGENT_EMBED_MODEL=text-embedding-3-small
AGENT_EMBED_DIM=1536

# ---- 预留：MCP 工具接入尚未内置 ----
MCP_SERVER_URL=

AGENT_WORKSPACE_ID=1
