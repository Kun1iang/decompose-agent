# ---- LLM（必填）----
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini

# ---- 可选 ----
JWT_SECRET=dev-secret
LOG_LEVEL=INFO
LOG_FORMAT=console

# ---- 示例域开关（默认关；置 1 看 example_todo）----
ENABLE_EXAMPLE_DOMAIN=0

# ---- skills（Markdown 能力包；目录不存在 = 无 skill）----
SKILLS_DIR=skills

# ---- memory（默认 in-memory；留空 = 关闭外部依赖）----
ENABLE_LLM_PREF_EXTRACTION=0
AGENT_PG_DSN=
AGENT_EMBED_BASE_URL=
AGENT_EMBED_API_KEY=
AGENT_EMBED_MODEL=text-embedding-3-small
AGENT_EMBED_DIM=1536

# ---- 预留：MCP 工具接入尚未内置 ----
MCP_SERVER_URL=

AGENT_WORKSPACE_ID=1
